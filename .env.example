# OpenRouter API Key for Gemini Models (gemini-2.5-flash, gemini-2.5-pro)
OPENROUTER_API_KEY=your_openrouter_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Configurations
DEFAULT_LLM_MODEL=gemini-3.1-flash-lite
ADVANCED_LLM_MODEL=gemini-3.1-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Embedding Model Configuration
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Database & Storage Paths
SQLITE_DB_PATH=./data/processed/restaurant_operations.db
CHROMA_PERSIST_DIR=./data/processed/chroma_db
RAW_DATA_DIR=./datasets
PROCESSED_DATA_DIR=./data/processed
SAMPLE_DATA_DIR=./data/sample_data

# Server Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=8501
API_URL=http://localhost:8000

# Authentication & Security
ADMIN_TOKEN_SECRET=your_random_secret_token_key_here
ADMIN_TOKEN_TTL_SECONDS=86400
STREAMLIT_ORIGIN=http://localhost:8501
DEMO_ADMIN_PASSWORD=AdminPass2026!
DEMO_USER_PASSWORD=UserPass2026!
