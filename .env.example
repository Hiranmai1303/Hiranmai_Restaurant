# OpenRouter API Key for Gemini Models (gemini-2.5-flash, gemini-2.5-pro)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# LLM Configurations
DEFAULT_LLM_MODEL=google/gemini-2.5-flash
ADVANCED_LLM_MODEL=google/gemini-2.5-pro
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Embedding Model Configuration
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Database & Storage Paths
SQLITE_DB_PATH=./data/processed/restaurant_operations.db
CHROMA_PERSIST_DIR=./data/processed/chroma_db
RAW_DATA_DIR=./datasets
PROCESSED_DATA_DIR=./data/processed
SAMPLE_DATA_DIR=./data/sample_data

# Server Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=8501
API_URL=http://localhost:8000
